rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        let p = d.progress;
        return d.keys().hasOnly(['version', 'progress', 'updatedAt'])
          && d.version == 1 && d.updatedAt == request.time
          && p.keys().hasOnly(['solved','practice','drafts','checks','codeSnapshots','last','name'])
          && p.solved is list && p.solved.size() <= 42
          && p.practice is list && p.practice.size() <= 21
          && p.drafts is map && p.drafts.size() <= 21
          && p.checks is map && p.checks.size() <= 21
          && p.codeSnapshots is map && p.codeSnapshots.size() <= 21
          && p.last is int && p.last >= 0 && p.last < 21
          && p.name is string && p.name.size() <= 80;
      }
      allow get: if owner();
      allow create, update: if owner() && valid();
    }
  }
}
